# Local Vulkan recipes, the setup's shader head start and its model sweep must not survive changes to the
# code that interprets them, and should survive every other change (an update that leaves the renderer as
# it was keeps the player's prepared shaders). The inputs: cmake/pipeline_identity_inputs.txt (why those).
# Hash public runtime sources, never generated game code or local cache data.
function(wwhd_pipeline_runtime_identity source_root output)
  set(list_file "${source_root}/cmake/pipeline_identity_inputs.txt")
  if(NOT EXISTS "${list_file}")
    set(list_file "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pipeline_identity_inputs.txt")
  endif()
  if(EXISTS "${list_file}")
    file(STRINGS "${list_file}" entries)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${list_file}")
  else()  # (a source tree without the list: the renderer folders)
    set(entries runtime/src/gfx runtime/src/gx2 runtime/include runtime/third_party/cemu)
  endif()
  # Source files only: any other file there (Finder's .DS_Store, an editor's swap file) re-ran cmake and
  # recompiled the Vulkan backend when it came or went, though no code changed.
  set(inputs)
  set(patterns)
  foreach(entry IN LISTS entries)
    string(STRIP "${entry}" entry)
    if(entry STREQUAL "" OR entry MATCHES "^#")
      continue()
    endif()
    if(IS_DIRECTORY "${source_root}/${entry}")
      foreach(extension c cpp h hpp inc mm)
        list(APPEND patterns "${source_root}/${entry}/*.${extension}")
      endforeach()
    elseif(EXISTS "${source_root}/${entry}")
      list(APPEND inputs "${source_root}/${entry}")
    endif()
  endforeach()
  if(patterns)
    file(GLOB_RECURSE found CONFIGURE_DEPENDS ${patterns})
    list(APPEND inputs ${found})
  endif()
  list(REMOVE_DUPLICATES inputs)
  list(SORT inputs)
  set(material "pipeline-runtime-2\n")
  foreach(input IN LISTS inputs)
    if(NOT IS_DIRECTORY "${input}")
      # Content edits, additions and removals all trigger automatic reconfiguration.
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
      file(RELATIVE_PATH relative "${source_root}" "${input}")
      file(SHA256 "${input}" digest)
      string(APPEND material "${relative}\n${digest}\n")
    endif()
  endforeach()
  string(SHA256 identity "${material}")
  set(${output} "${identity}" PARENT_SCOPE)
endfunction()
