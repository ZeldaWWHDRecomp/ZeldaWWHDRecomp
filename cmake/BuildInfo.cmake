# Writes OUT (a C++ source with build::version() and build::commit(), runtime/src/build_info.h) on
# every build, rewriting it only when the text changes (so a rebuild recompiles one small file only
# after a new commit). Run as: cmake -DSRC=<source dir> -DOUT=<file> [-DVERSION=<tag>] -P BuildInfo.cmake
#
# version: VERSION when given (release builds: the tag, e.g. v0.2.5; .github/workflows/release.yml),
#   else from the newest v* tag: "v0.2.5" on the tagged commit, "v0.2.5+3" three commits after it,
#   "dev" without git or tags (a source archive)
# commit:  the short commit hash, "-dirty" with uncommitted changes to tracked files, "unknown" without git
# variant: VARIANT ("decomp" for the decomp build, WWHD_DECOMP; empty for the normal build)
set(version "${VERSION}")
set(commit "unknown")
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SRC}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-parse --short=7 HEAD
                  OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0 AND head)
    set(commit "${head}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" diff --quiet HEAD -- RESULT_VARIABLE dirty
                    OUTPUT_QUIET ERROR_QUIET)
    if(dirty EQUAL 1)
      string(APPEND commit "-dirty")
    endif()
  endif()
  if(COMMIT)
    set(commit "${COMMIT}")  # a local build that keeps the release's identity (pipeline caches)
  endif()
  if(NOT version)
    # A release tagged on a main merge commit (e.g. v0.5.1) has its devel commit as t^2, so git describe on
    # devel would stop at an older tag and make port_version_from_build() one patch version too low.
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" tag -l "v[0-9]*" --sort=-version:refname
                    OUTPUT_VARIABLE tags OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(rc EQUAL 0 AND tags)
      string(REPLACE "\n" ";" tags "${tags}")
      foreach(t IN LISTS tags)
        foreach(ref "${t}" "${t}^2")
          execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" merge-base --is-ancestor "${ref}" HEAD
                          RESULT_VARIABLE anc OUTPUT_QUIET ERROR_QUIET)
          if(anc EQUAL 0)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SRC}" rev-list --count "${ref}..HEAD"
                            OUTPUT_VARIABLE count OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE crc)
            if(crc EQUAL 0)
              set(version "${t}")
              if(NOT count EQUAL 0)
                string(APPEND version "+${count}")
              endif()
              break()
            endif()
          endif()
        endforeach()
        if(version)
          break()
        endif()
      endforeach()
    endif()
  endif()
endif()
if(NOT version)
  set(version "dev")
endif()
# no quotes or backslashes in the C string
string(REGEX REPLACE "[\"\\\\]" "" version "${version}")

set(text "// generated by cmake/BuildInfo.cmake; do not edit
#include \"build_info.h\"
namespace build {
const char* version() { return \"${version}\"; }
const char* commit() { return \"${commit}\"; }
const char* variant() { return \"${VARIANT}\"; }
}  // namespace build
")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
