# cmake -P tests/cmake/decomp_hooks_digest_test.cmake: DecompHooks.cmake's digest ignores only the header line
# naming the decomp commit. Writes its temporary files to WWHD_TEST_DIR (default: the current directory's
# decomp_hooks_digest_test/) and removes them at the end.
cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/DecompHooks.cmake")
if(NOT WWHD_TEST_DIR)
  set(WWHD_TEST_DIR "${CMAKE_CURRENT_BINARY_DIR}/decomp_hooks_digest_test")
endif()
file(MAKE_DIRECTORY "${WWHD_TEST_DIR}")
set(head "# generated by tools/decomp_build/gen.py: the decompiled functions of the decomp build\n")
set(body "02000020  # hd_ui_02000020 constructInputReceiver\n02000040  # hd_ui_02000040 other\n")
function(digest_of name text out)
  file(WRITE "${WWHD_TEST_DIR}/${name}" "${text}")
  wwhd_decomp_hooks_digest("${WWHD_TEST_DIR}/${name}" d)
  set(${out} "${d}" PARENT_SCOPE)
endfunction()
digest_of(a.txt "${head}# (canonical addresses; recomp.py --decomp-hooks) from decomp 8f721ddeb3bc43ecad1df9acde0590944a17a320\n${body}" a)
digest_of(b.txt "${head}# (canonical addresses; recomp.py --decomp-hooks) from decomp fe77fef1c5f4acffdcb2ab18f63845b1dec1eecb\n${body}" b)
digest_of(c.txt "${head}# (canonical addresses; recomp.py --decomp-hooks) from decomp 8f721ddeb3bc43ecad1df9acde0590944a17a320\n${body}02000060  # hd_ui_02000060 added\n" c)
digest_of(d.txt "# generated by another tool\n# (canonical addresses; recomp.py --decomp-hooks) from decomp 8f721ddeb3bc43ecad1df9acde0590944a17a320\n${body}" d)
digest_of(e.txt "${head}# (canonical addresses; recomp.py --decomp-hooks) from decomp 8f721ddeb3bc43ecad1df9acde0590944a17a320\n02000020  # hd_ui_02000020 constructInputReceiver\n02000044  # hd_ui_02000040 other\n" e)
file(REMOVE_RECURSE "${WWHD_TEST_DIR}")
set(failed 0)
macro(expect same x y what)
  if((${same} AND "${x}" STREQUAL "${y}") OR (NOT ${same} AND NOT "${x}" STREQUAL "${y}"))
    message(STATUS "ok: ${what}")
  else()
    message(SEND_ERROR "FAIL: ${what}")
    set(failed 1)
  endif()
endmacro()
expect(TRUE "${a}" "${b}" "a header-only change (another decomp commit) gives the same digest")
expect(FALSE "${a}" "${c}" "an added function changes the digest")
expect(FALSE "${a}" "${d}" "another first comment line changes the digest")
expect(FALSE "${a}" "${e}" "a changed address changes the digest")
if(failed)
  message(FATAL_ERROR "decomp_hooks_digest_test: failed")
endif()
